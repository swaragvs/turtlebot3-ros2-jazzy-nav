cat << 'EOF' > .gitignore
# Python compilation & cache artifacts
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging build directories
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ROS 2 specific local artifacts
install/
log/
*.log

# Editor & IDE configurations
.vscode/
.idea/
*.swp
*~

# Operating System files
.DS_Store
Thumbs.db
EOF
